[Unit]
Description=SongCraft Studio backup and restore worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=songcraft-renderer
Group=songcraft-renderer
WorkingDirectory=/opt/songcraft-studio/workers/backup
EnvironmentFile=/etc/songcraft-studio/backup.env
ExecStart=/usr/bin/node /opt/songcraft-studio/workers/backup/backup-worker.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Stejný systémový účet jako renderer, ale jiný env soubor: renderer nesmí
# dostat service_role jen proto, že běží vedle. Backup ho potřebuje, protože
# čte data všech uživatelů a nahrává archiv do songcraft-backups.
ReadWritePaths=/var/lib/songcraft-studio /tmp

[Install]
WantedBy=multi-user.target